{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python hooks/validate-design.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "yomiyasu@yomiyasu": true,
    "decision-analysis@decision-analysis": true
  },
  "extraKnownMarketplaces": {
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu",
        "ref": "v3.1.0"
      }
    },
    "decision-analysis": {
      "source": {
        "source": "github",
        "repo": "etoyama/decision-analysis"
      }
    }
  }
}
