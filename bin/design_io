#!/usr/bin/env sh
# Wrapper so the analysis skills can call design_io from an INSTALLED plugin. See bin/_prelude.sh.
set -e

name=design_io setup_exit=1
. "$(dirname "$0")/_prelude.sh"

mkdir -p "$INSIGHT_BASE_DIR/designs" \
         "$INSIGHT_BASE_DIR/catalog/sources" \
         "$INSIGHT_BASE_DIR/catalog/knowledge"

exec uv run python -m skills._shared.design_io "$@"
