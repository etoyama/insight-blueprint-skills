#!/usr/bin/env sh
# Wrapper so the catalog skills can call catalog_io from an INSTALLED plugin. See bin/_prelude.sh.
set -e

name=catalog_io setup_exit=1
. "$(dirname "$0")/_prelude.sh"

mkdir -p "$INSIGHT_BASE_DIR/designs" \
         "$INSIGHT_BASE_DIR/catalog/sources" \
         "$INSIGHT_BASE_DIR/catalog/knowledge"

exec uv run python -m skills._shared.catalog_io "$@"
